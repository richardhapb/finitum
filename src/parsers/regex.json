{
    "banco_chile": {
        "remitents": ["enviodigital@bancochile.cl", "serviciodetransferencias@bancochile.cl"],
        "subject": {
            "exclusions": [
                "entre mis cuentas"
            ],
            "purchase": "(?:cargo en cuenta|compra con tarjeta)",
            "withdrawal": "giro",
            "transference": "transferencia"
        },
        "body": {
            "amountPurchase": "compra\\s+por\\s+(\\S+)",
            "amountTransference": "Monto\\s*(\\S+)\\s*(?:Mensaje|ID)",
            "amountWithdrawal": "giro en Cajero\\s+por\\s+(\\S+)",
            "date": "\\d{1,2}/\\d{1,2}/\\d{4}(?:\\s+\\d{1,2}:\\d{2})?",
            "commerce": "compra\\s+por\\s+\\S+\\s*con\\s*\\D+\\d+\\s*en\\s*(.+)\\s*el\\s*\\d{1,2}/\\d{1,2}/\\d{4}(?:\\s+\\d{1,2}:\\d{2})?",
            "transferenceRecipient": "Nombre(?:\\s+y\\s+Apellido)?\\s+([\\s\\S]*?)\\s*Rut",
            "transferenceMatches": "(?:has realizado|ha efectuado)"
        }
    },
    "santander": {
        "remitents": ["mensajeria@santander.cl"],
        "subject": {
            "exclusions": [],
            "purchase": "comprobante pago",
            "withdrawal": "giro",
            "transference": "transferencia de fondos"
        },
        "body": {
            "amountPurchase": "Monto pagado\\s+>\\s+\\$([\\d.]+)",
            "amountTransference": "Monto transferido\\n*\\$\\s*([\\d.]+)",
            "amountWithdrawal": "Monto\\s+>\\s+\\$([\\d.]+)",
            "date": "\\d{1,2}[-/]\\d{1,2}[-/]\\d{4}",
            "commerce": "Compa[^>]+>\\s*([A-Za-z0-9\\s]+?)\\s*=09",
            "transferenceRecipient": "Datos de destino[\\s\\S]*?Nombre\\s+([A-Za-zÁÉÍÓÚáéíóúÑñ\\s]+?)\\s+RUT",
            "transferenceMatches": ""
        }
    }
}
